# Copiez ce fichier en .env.local et remplissez avec vos clés Supabase
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_public_key

# Ton uuid utilisateur (Authentication → Users) — obligatoire pour imports seed
OWNER_USER_ID=

# Optionnel — active l’import one-shot /import (désactivé par défaut)
# ALLOW_HISTORICAL_IMPORT=true
